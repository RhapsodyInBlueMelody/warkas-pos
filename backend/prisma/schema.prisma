generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN // pemilik toko
  KASIR
}

enum Plan {
  FREE
  TOKO
}

// Satu baris = satu toko/warung. Semua data bisnis menempel ke Store lewat storeId.
model Store {
  storeId   String   @id @default(uuid())
  name      String
  plan      Plan     @default(FREE)
  // Paket TOKO berlaku sampai planExpiresAt (null = tanpa batas waktu); lewat dari itu dianggap FREE.
  planExpiresAt DateTime?
  planIsTrial   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  categories     Category[]
  suppliers      Supplier[]
  products       Product[]
  transactions   Transaction[]
  stockMovements StockMovement[]
  customers      Customer[]
  debtEntries    DebtEntry[]
}

model User {
  userId    String   @id @default(uuid())
  code      String
  name      String
  username  String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  store   Store  @relation(fields: [storeId], references: [storeId])
  storeId String

  transactions Transaction[]

  @@unique([storeId, code])
}

model Category {
  categoryId String   @id @default(uuid())
  code       String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  updatedBy  String

  store   Store  @relation(fields: [storeId], references: [storeId])
  storeId String

  products Product[]

  @@unique([storeId, code])
}

model Supplier {
  supplierId String   @id @default(uuid())
  code       String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String
  updatedBy  String

  store   Store  @relation(fields: [storeId], references: [storeId])
  storeId String

  products Product[]

  @@unique([storeId, code])
}

model Product {
  productId String   @id @default(uuid())
  code      String
  name      String
  price     Decimal
  // Harga modal. Null = belum diisi; produk tanpa modal tidak ikut hitungan untung.
  costPrice Decimal?
  stock     Int
  // Stok dianggap menipis bila stock <= minStock.
  minStock  Int      @default(5)
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  store   Store  @relation(fields: [storeId], references: [storeId])
  storeId String

  supplier   Supplier? @relation(fields: [supplierId], references: [supplierId])
  supplierId String?
  category   Category? @relation(fields: [categoryId], references: [categoryId])
  categoryId String?

  transactionItems TransactionItem[]
  stockMovement    StockMovement[]

  @@unique([storeId, code])
  @@index([storeId])
}

enum PaymentMethod {
  QRIS
  CASH
  TRANSFER
  BON // dibayar nanti; menambah utang pelanggan
}

model Transaction {
  transactionId String        @id @default(uuid())
  code          String        @unique
  totalPrice    Decimal
  createdAt     DateTime      @default(now())
  paymentMethod PaymentMethod

  store   Store  @relation(fields: [storeId], references: [storeId])
  storeId String

  kasir   User   @relation(fields: [kasirId], references: [userId])
  kasirId String

  // Terisi hanya untuk transaksi BON.
  customer   Customer? @relation(fields: [customerId], references: [customerId])
  customerId String?
  debtEntry  DebtEntry?

  items TransactionItem[]

  @@index([storeId, createdAt])
}

model TransactionItem {
  transactionItemId String  @id @default(uuid())
  code              String  @unique
  quantity          Int
  priceAtTime       Decimal
  // Salinan harga modal saat transaksi, supaya laporan lama tidak berubah bila modal diedit.
  costAtTime        Decimal?

  transaction  Transaction @relation(fields: [transactionId], references: [transactionId])
  transactionId String

  product   Product @relation(fields: [productId], references: [productId])
  productId String
}

// Pelanggan yang boleh berutang. Nama boleh kembar (dua "Bu Ani"); bedakan lewat nomor telepon.
model Customer {
  customerId String   @id @default(uuid())
  name       String
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String

  store   Store  @relation(fields: [storeId], references: [storeId])
  storeId String

  transactions Transaction[]
  entries      DebtEntry[]

  @@index([storeId, name])
}

enum DebtEntryType {
  CHARGE  // utang bertambah
  PAYMENT // utang dibayar (boleh cicilan)
}

// Buku besar bon: hanya ditambah, tidak diubah. Sisa utang = total CHARGE - total PAYMENT.
// Di database ada CHECK (amount > 0) yang tidak terlihat oleh Prisma.
model DebtEntry {
  debtEntryId String        @id @default(uuid())
  type        DebtEntryType
  amount      Decimal
  note        String?
  createdAt   DateTime      @default(now())
  createdBy   String

  store   Store  @relation(fields: [storeId], references: [storeId])
  storeId String

  customer   Customer @relation(fields: [customerId], references: [customerId])
  customerId String

  // Terisi bila CHARGE berasal dari checkout BON. Satu transaksi paling banyak satu CHARGE.
  transaction   Transaction? @relation(fields: [transactionId], references: [transactionId])
  transactionId String?      @unique

  @@index([storeId, customerId])
  @@index([storeId, createdAt])
}

enum Reason {
  PURCHASE
  ADJUSTMENT
  RETURN
}

model StockMovement {
  stockMovementId String   @id @default(uuid())
  code            String   @unique
  quantity        Int
  reason          Reason
  createdAt       DateTime @default(now())
  createdBy       String

  store   Store  @relation(fields: [storeId], references: [storeId])
  storeId String

  product   Product @relation(fields: [productId], references: [productId])
  productId String
}
